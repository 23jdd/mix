let name = "mix";
let numbers = [1, 2, 3, 4,7,8,9];

fn sum(values) {
    let total = 0;
    for value in values {
        total += value;
    }
    return total;
}

if name == "mix" {
    print(name, sum(numbers));
} else {
    print("unknown language");
}
